		if err != nil {
			if err == services.ErrNotFound {
				writeError(w, http.StatusNotFound, "el movimiento no existe")
				return nil
			}
			writeError(w, http.StatusBadRequest, err.Error())
			return nil
		}

		cuentas, err := cuentaStore.Read()
