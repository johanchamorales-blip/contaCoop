		{ID: 1, CuentaID: 1, Tipo: models.TipoEgreso, Monto: 100, NumeroDocumento: "1001", Beneficiario: "Ana",
			FechaOperacion: models.NuevaFecha(2026, time.June, 27), Estado: models.EstadoEgresoEmitido},
