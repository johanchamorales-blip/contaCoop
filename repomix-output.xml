	_, _ = w.Write([]byte{0xEF, 0xBB, 0xBF})

	cw := csv.NewWriter(w)
	_ = cw.Write([]string{"REPORTE ANUAL"})
	_ = cw.Write([]string{"Cuenta", resultado.Numero + " " + resultado.Nombre})
