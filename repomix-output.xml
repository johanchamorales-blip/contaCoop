func TestGenerarLibroBancosSinFiltro(t *testing.T) {
	cuenta := models.Cuenta{ID: 1, Numero: "001", SaldoInicial: 1000}
	cooperativa := models.Cooperativa{ID: 1, Nombre: "Coop", Direccion: "Zona 1", NIT: "36029785"}
