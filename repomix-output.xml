		{ID: 3, CuentaID: 2, Tipo: models.TipoEgreso, Monto: 25, NumeroDocumento: "2001",
			FechaOperacion: models.NuevaFecha(2026, time.September, 20), Estado: models.EstadoEgresoCobrado,
