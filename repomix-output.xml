package services

import "testing"

func TestQRedondeaACentavos(t *testing.T) {
	casos := map[float64]float64{
		0.1 + 0.2:  0.3,
		2.675:      2.68,
		-2.675:     -2.68,
		1234.56789: 1234.57,
	}
	for entrada, esperado := range casos {
		if got := Q(entrada); got != esperado {
			t.Fatalf("Q(%v) = %v, se esperaba %v", entrada, got, esperado)
		}
	}
}

