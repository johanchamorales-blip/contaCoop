func sesionCookie(t *testing.T) *http.Cookie {
	t.Helper()
	usuario := models.Usuario{ID: 1, Usuario: "Admin", Rol: "ADMINISTRADOR", Activo: true}
	prueba := httptest.NewRecorder()
